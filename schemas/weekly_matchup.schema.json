{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/williepowen-debug/FFB-RESEARCH/schemas/weekly_matchup.schema.json",
  "title": "Weekly matchup metadata",
  "type": "object",
  "required": ["schema_version", "record_id", "record_type", "title", "team_ids", "player_ids", "season", "week", "status", "time_horizon", "valid_as_of", "last_verified", "confidence", "source_ids", "supersedes", "game_id", "fantasy_formats"],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {"type": ["string", "null"], "pattern": "^wm-(?:[0-9]{4}|all)-[a-z0-9-]+-[0-9]{3}$"},
    "record_type": {"const": "weekly_matchup"},
    "title": {"type": "string", "minLength": 1},
    "team_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2, "uniqueItems": true},
    "player_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "season": {"type": "integer", "minimum": 2000, "maximum": 2100},
    "week": {"type": "integer", "minimum": 1, "maximum": 18},
    "status": {"enum": ["draft", "active", "superseded", "invalidated"]},
    "time_horizon": {"const": "weekly"},
    "valid_as_of": {"type": ["string", "null"], "format": "date"},
    "last_verified": {"type": ["string", "null"], "format": "date"},
    "confidence": {"type": ["string", "null"], "enum": ["low", "medium", "high", null]},
    "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "game_id": {"type": ["string", "null"], "pattern": "^[0-9]{4}-W[0-9]{2}-[A-Z]{2,3}-[A-Z]{2,3}$"},
    "fantasy_formats": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
