{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/williepowen-debug/FFB-RESEARCH/schemas/team_intelligence.schema.json",
  "title": "Team intelligence synthesis metadata",
  "type": "object",
  "required": ["schema_version", "record_id", "record_type", "title", "team_ids", "player_ids", "season", "week", "status", "time_horizon", "valid_as_of", "last_verified", "confidence", "source_ids", "supersedes", "observation_ids", "run_ids"],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {"type": ["string", "null"], "pattern": "^ti-(?:[0-9]{4}|all)-[a-z0-9-]+-[0-9]{8}-[0-9]{3}$"},
    "record_type": {"const": "team_intelligence"},
    "title": {"type": "string", "minLength": 1},
    "team_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 1},
    "player_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "season": {"type": ["integer", "null"], "minimum": 2000, "maximum": 2100},
    "week": {"type": ["integer", "null"], "minimum": 1, "maximum": 18},
    "status": {"enum": ["draft", "active", "superseded", "invalidated"]},
    "time_horizon": {"enum": ["seasonal", "weekly"]},
    "valid_as_of": {"type": ["string", "null"], "format": "date"},
    "last_verified": {"type": ["string", "null"], "format": "date"},
    "confidence": {"type": ["string", "null"], "enum": ["low", "medium", "high", null]},
    "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "observation_ids": {"type": "array", "items": {"type": "string", "pattern": "^obs-[0-9]{4}-[a-z0-9]+-[0-9]{8}t[0-9]{6}z-[0-9]{3}$"}, "uniqueItems": true},
    "run_ids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
